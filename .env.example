# Published proxy ports on the Docker host
HTTP_PROXY_PORT=3128
SOCKS_PROXY_PORT=1080
PROMETHEUS_PORT=9090

# Credentials used by both HTTP CONNECT and SOCKS5
PROXY_USERNAME=proxy
PROXY_PASSWORD=change-me

# Comma-separated destination whitelist for both HTTP and SOCKS5.
# Supports IPs, CIDRs, and hostname patterns such as .example.com.
# Empty means deny all destinations.
PROXY_WHITELIST=api.ipify.org,z.ai,*.z.ai,cursor.com,*.cursor.com,*.cursor.sh,*.cursor-cdn.com,*.cursorapi.com,*.cursorvm.com,*.*.cursorvm.com,example.com,*.example.org,203.0.113.10,198.51.100.0/24

TZ=UTC
# Comma-separated LAN/CIDR ranges allowed to bypass the VPN firewall, if needed
# FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24

# Initial VPN health-check grace period
HEALTH_VPN_DURATION_INITIAL=120s
HEALTH_VPN_DURATION_ADDITION=5s

# Keep control API private by default. Set basic auth before publishing port 8000.
CONTROL_SERVER_AUTH_DEFAULT_ROLE={"auth":"none"}
